{
  "name": "github-desktop-plus",
  "displayName": "GitHub Desktop Plus",
  "description": "GitHub Desktop Plus brings GitHub Desktop's complete workflow to VS Code: staged/unstaged change sections, a commit box with draft persistence, branch and sync controls, conflict resolution, stashes and multi-account support.",
  "version": "2.0.1",
  "publisher": "piotroszko",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/piotroszko/github-desktop-plus"
  },
  "engines": {
    "vscode": ">=1.84.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "github desktop",
    "source control",
    "commit",
    "branch",
    "repository",
    "multi-account",
    "github-desktop-plus"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "githubDesktopPlus.signIn",
        "title": "Sign In",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.signOut",
        "title": "Sign Out",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.signOutAccount",
        "title": "Sign Out",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.switchAccount",
        "title": "Switch Active Account",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.switchToAccount",
        "title": "Switch to Account",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.cloneRepository",
        "title": "Clone Repository",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.openRepository",
        "title": "Open Repository",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.selectRepositoryAccount",
        "title": "Select Account for Repository",
        "category": "GitHub Desktop Plus",
        "icon": "$(account)"
      },
      {
        "command": "githubDesktopPlus.selectBaseBranch",
        "title": "Select Base Branch for Repository",
        "category": "GitHub Desktop Plus",
        "icon": "$(git-compare)"
      },
      {
        "command": "githubDesktopPlus.useAccountForRepository",
        "title": "Use Account for Current Repository",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.createIssue",
        "title": "Create Issue",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.refreshViews",
        "title": "Refresh Views",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.addAccount",
        "title": "Add GitHub Account",
        "category": "GitHub Desktop Plus",
        "icon": "$(plus)"
      },
      {
        "command": "githubDesktopPlus.manageAccounts",
        "title": "Manage GitHub Accounts",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.removeAccount",
        "title": "Remove Account",
        "category": "GitHub Desktop Plus"
      },
      {
        "command": "githubDesktopPlus.refreshAccounts",
        "title": "Refresh Accounts",
        "category": "GitHub Desktop Plus",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "githubDesktopPlus",
          "title": "GitHub Desktop Plus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "githubDesktopPlus": [
        {
          "id": "githubDesktopPlus.timeline",
          "name": "History",
          "type": "webview",
          "icon": "$(history)"
        },
        {
          "id": "githubDesktopPlus.accounts",
          "name": "Accounts",
          "icon": "$(account)",
          "collapsed": true
        },
        {
          "id": "githubDesktopPlus.repositories",
          "name": "Repositories",
          "icon": "$(repo)",
          "collapsed": true
        }
      ]
    },
    "configuration": [
      {
        "title": "GitHub Desktop Plus",
        "properties": {
          "githubDesktopPlus.commitMessageCommand": {
            "type": "string",
            "default": "omp",
            "description": "Command behind the Generate button next to the commit Summary field. It receives the diff on stdin and must print the commit message on stdout."
          },
          "githubDesktopPlus.commitMessageArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "-p",
              "--model",
              "commit"
            ],
            "description": "Arguments passed to the commit message command, before the built-in prompt. The prompt asks for a conventional-commit subject (feat:, fix:, …) and keeps the whole message within 100 characters."
          }
        }
      },
      {
        "title": "Git",
        "order": 1,
        "properties": {
          "githubDesktopPlus.git.path": {
            "type": "string",
            "default": "",
            "markdownDescription": "Executable used for every git command. Leave empty to use the `git` found on `PATH`; set an absolute path (e.g. `/opt/homebrew/bin/git`, `C:\\\\Program Files\\\\Git\\\\cmd\\\\git.exe`) when VS Code does not inherit the shell that has git."
          },
          "githubDesktopPlus.git.defaultRemote": {
            "type": "string",
            "default": "origin",
            "markdownDescription": "Remote that operations naming a remote use: pushing an unpublished branch (`-u`), publishing, force-pushing, fetching a pull request, pushing a tag, and reading repository metadata. Prefer the configured remote when a repository has it, otherwise the first remote it has."
          },
          "githubDesktopPlus.diff.contextLines": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "maximum": 50,
            "description": "Lines of unchanged context shown around each hunk in the working-tree and commit diffs. 0 shows only the changed lines."
          },
          "githubDesktopPlus.stash.includeUntracked": {
            "type": "boolean",
            "default": true,
            "description": "Include untracked files when stashing, so files git has never seen are saved with the stash instead of being left behind."
          }
        }
      },
      {
        "title": "History",
        "order": 2,
        "properties": {
          "githubDesktopPlus.history.pageSize": {
            "type": "number",
            "default": 50,
            "minimum": 10,
            "maximum": 500,
            "description": "Commits loaded per page in the History list, for the first page and for each \"load more\". Lower it for faster refreshes on very large repositories."
          },
          "githubDesktopPlus.history.dateFormat": {
            "type": "string",
            "enum": [
              "relative",
              "absolute"
            ],
            "default": "relative",
            "enumDescriptions": [
              "\"3 days ago\"",
              "The time git recorded, e.g. \"2026-10-12 14:26\""
            ],
            "description": "How commit dates are shown in the History list."
          },
          "githubDesktopPlus.autoRefreshInterval": {
            "type": "number",
            "default": 30,
            "minimum": 0,
            "description": "Seconds between automatic refreshes of the History panel while it is visible, so changes made outside VS Code (git commands in a terminal, other tools) show up. Set to 0 to disable periodic refreshes — the panel still refreshes when it regains focus or a file is saved in VS Code."
          }
        }
      },
      {
        "title": "Interface",
        "order": 3,
        "properties": {
          "githubDesktopPlus.ui.avatars": {
            "type": "string",
            "enum": [
              "github",
              "none"
            ],
            "default": "github",
            "enumDescriptions": [
              "Load avatar images from GitHub",
              "Show theme icons and initials instead — no requests to GitHub for images"
            ],
            "markdownDescription": "Where avatars come from, in the History list and in the Accounts tree. `none` keeps the extension from looking up commit authors and loading avatar images, useful on metered connections or when the images are noise."
          },
          "githubDesktopPlus.ui.activityBarBadge": {
            "type": "boolean",
            "default": true,
            "description": "Show the number of pending changes on the activity bar icon."
          }
        }
      },
      {
        "title": "Confirmations",
        "order": 4,
        "properties": {
          "githubDesktopPlus.confirm.destructiveActions": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Ask for confirmation before actions that lose work or rewrite published history: discarding changes, undoing a commit, amending a pushed commit, resetting to a commit, force-pushing, dropping a stash, merging into the default branch. Turning this off performs them immediately."
          }
        }
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "githubDesktopPlus.useAccountForRepository",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.account",
          "group": "1_modification@1"
        },
        {
          "command": "githubDesktopPlus.useAccountForRepository",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.activeAccount",
          "group": "1_modification@1"
        },
        {
          "command": "githubDesktopPlus.selectRepositoryAccount",
          "when": "view == githubDesktopPlus.repositories && viewItem == githubDesktopPlus.repository",
          "group": "inline@1"
        },
        {
          "command": "githubDesktopPlus.selectRepositoryAccount",
          "when": "view == githubDesktopPlus.repositories && viewItem == githubDesktopPlus.repository",
          "group": "1_modification@1"
        },
        {
          "command": "githubDesktopPlus.selectBaseBranch",
          "when": "view == githubDesktopPlus.repositories && viewItem == githubDesktopPlus.repository",
          "group": "inline@2"
        },
        {
          "command": "githubDesktopPlus.selectBaseBranch",
          "when": "view == githubDesktopPlus.repositories && viewItem == githubDesktopPlus.repository",
          "group": "1_modification@2"
        },
        {
          "command": "githubDesktopPlus.signOutAccount",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.account"
        },
        {
          "command": "githubDesktopPlus.signOutAccount",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.activeAccount"
        },
        {
          "command": "githubDesktopPlus.removeAccount",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.account"
        },
        {
          "command": "githubDesktopPlus.removeAccount",
          "when": "view == githubDesktopPlus.accounts && viewItem == githubDesktopPlus.activeAccount"
        }
      ],
      "view/title": [
        {
          "command": "githubDesktopPlus.addAccount",
          "when": "view == githubDesktopPlus.accounts",
          "group": "navigation@1"
        },
        {
          "command": "githubDesktopPlus.refreshAccounts",
          "when": "view == githubDesktopPlus.accounts",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package --no-dependencies --allow-missing-repository --allow-package-secrets github",
    "test": "npm run compile && node ./out/test/runTest.js",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "26.x",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "simple-git": "^3.36.0"
  },
  "volta": {
    "node": "22.23.2"
  }
}
